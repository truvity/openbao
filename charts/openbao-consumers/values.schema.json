{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "openbao-consumers values",
  "description": "An unknown key is an error, not a silent no-op: a typo in a store's values would otherwise render a store that quietly reads somewhere else.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object"
    },
    "commonAnnotations": {
      "$ref": "#/definitions/stringMap"
    },
    "server": {
      "type": "string"
    },
    "caBundle": {
      "type": "string"
    },
    "vaultNamespace": {
      "type": "string"
    },
    "kvMount": {
      "type": "string",
      "minLength": 1
    },
    "storeSuffix": {
      "type": "string",
      "minLength": 1
    },
    "writerAuthMount": {
      "type": "string"
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mountPath": {
          "type": "string",
          "minLength": 1
        },
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "expirationSeconds": {
          "type": "integer",
          "minimum": 600,
          "maximum": 86400
        },
        "serviceAccount": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "namespace": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "stores": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string"
          },
          "vaultNamespace": {
            "type": "string"
          },
          "annotations": {
            "$ref": "#/definitions/stringMap"
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    },
    "writers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "namespace": {
            "type": "string"
          },
          "serviceAccount": {
            "type": "string"
          },
          "environments": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "annotations": {
            "$ref": "#/definitions/stringMap"
          }
        }
      }
    },
    "pki": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        },
        "certManager": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "namespace": {
              "type": "string",
              "minLength": 1
            },
            "serviceAccountName": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "issuerServiceAccount": {
          "type": "string",
          "minLength": 1
        },
        "vaultNamespace": {
          "type": "string"
        },
        "trustAnchors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "certificate"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "certificate": {
                "type": "string",
                "minLength": 1,
                "description": "base64 PEM"
              },
              "labels": {
                "$ref": "#/definitions/stringMap"
              },
              "annotations": {
                "$ref": "#/definitions/stringMap"
              }
            }
          }
        },
        "rootKey": {
          "type": "string",
          "minLength": 1
        },
        "issuers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "signPath",
              "role"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "enum": [
                  "ClusterIssuer",
                  "Issuer"
                ]
              },
              "signPath": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "type": "string",
                "minLength": 1
              },
              "audiences": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "vaultNamespace": {
                "type": "string"
              },
              "annotations": {
                "$ref": "#/definitions/stringMap"
              },
              "identity": {
                "type": "boolean",
                "description": "Marks the SPIFFE identity issuer (the one csi-driver-spiffe requests from). The issuer is rendered like any other, but approverPolicy never renders a policy for it and refuses to be pointed at it: csi-driver-spiffe's own approver owns that signer."
              }
            }
          }
        },
        "bundle": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "annotations": {
              "$ref": "#/definitions/stringMap"
            },
            "extraSources": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "target": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "namespaceSelector": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "certificateDefaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "duration": {
          "type": "string"
        },
        "renewBefore": {
          "type": "string"
        },
        "privateKey": {
          "type": "object"
        }
      }
    },
    "certificates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "namespace": {
            "type": "string"
          },
          "secretName": {
            "type": "string"
          },
          "commonName": {
            "type": "string"
          },
          "dnsNames": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "uris": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "usages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "duration": {
            "type": "string"
          },
          "renewBefore": {
            "type": "string"
          },
          "privateKey": {
            "type": "object"
          },
          "issuerRef": {
            "type": "object"
          },
          "annotations": {
            "$ref": "#/definitions/stringMap"
          },
          "labels": {
            "$ref": "#/definitions/stringMap"
          }
        }
      }
    },
    "approverPolicy": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional cert-manager approver-policy layer for the issuers this chart creates. Off by default: enabling it renders CertificateRequestPolicy objects and the RBAC that lets cert-manager use them, and is only safe once approver-policy is installed.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        },
        "roleName": {
          "type": "string"
        },
        "requesters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "name"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "ServiceAccount",
                  "User",
                  "Group"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "namespace": {
                "type": "string"
              },
              "apiGroup": {
                "type": "string"
              }
            }
          }
        },
        "defaults": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minDuration": {
              "type": "string",
              "pattern": "^[0-9]+(ns|us|µs|ms|s|m|h)([0-9]+(ns|us|µs|ms|s|m|h))*$"
            },
            "maxDuration": {
              "type": "string",
              "pattern": "^[0-9]+(ns|us|µs|ms|s|m|h)([0-9]+(ns|us|µs|ms|s|m|h))*$"
            },
            "privateKey": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "algorithm": {
                  "type": "string",
                  "enum": [
                    "RSA",
                    "ECDSA",
                    "Ed25519"
                  ]
                },
                "minSize": {
                  "type": "integer",
                  "minimum": 1
                },
                "maxSize": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        },
        "issuers": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/approverConstraints"
          }
        },
        "namespacedIssuers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "definitions": {
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "approverConstraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commonName": {
          "type": "string"
        },
        "dnsNames": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "uris": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ipAddresses": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "emailAddresses": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "usages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "minDuration": {
          "type": "string",
          "pattern": "^[0-9]+(ns|us|µs|ms|s|m|h)([0-9]+(ns|us|µs|ms|s|m|h))*$"
        },
        "maxDuration": {
          "type": "string",
          "pattern": "^[0-9]+(ns|us|µs|ms|s|m|h)([0-9]+(ns|us|µs|ms|s|m|h))*$"
        },
        "privateKey": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": [
                "RSA",
                "ECDSA",
                "Ed25519"
              ]
            },
            "minSize": {
              "type": "integer",
              "minimum": 1
            },
            "maxSize": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    }
  }
}
