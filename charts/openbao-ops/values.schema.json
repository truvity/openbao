{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "openbao-ops values",
  "description": "An unknown key is an error, not a silent no-op: a typo in a snapshot's values would otherwise render a job that quietly backs up nothing.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": { "type": "object" },
    "commonAnnotations": { "$ref": "#/definitions/stringMap" },
    "namespace": { "type": "string" },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "address": { "type": "string" },
        "activeService": { "type": "string", "minLength": 1 },
        "service": { "type": "string", "minLength": 1 },
        "headlessService": { "type": "string", "minLength": 1 },
        "apiPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "clusterPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "tlsSecretName": { "type": "string", "minLength": 1 },
        "caKey": { "type": "string", "minLength": 1 },
        "tlsServerName": { "type": "string" },
        "podLabels": { "$ref": "#/definitions/stringMap" }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mountPath": { "type": "string", "minLength": 1 },
        "audience": { "type": "string", "minLength": 1 },
        "expirationSeconds": { "type": "integer", "minimum": 600, "maximum": 86400 },
        "tokenMountPath": { "type": "string", "pattern": "^/" }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "serviceAccountName": { "type": "string", "minLength": 1 },
        "serviceAccountAnnotations": { "$ref": "#/definitions/stringMap" },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "baoRole": { "type": "string", "minLength": 1 },
        "jobs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "schedule", "prefix"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "schedule": { "type": "string", "minLength": 1 },
              "prefix": { "type": "string" }
            }
          }
        },
        "timeZone": { "type": "string", "minLength": 1 },
        "startingDeadlineSeconds": { "type": "integer", "minimum": 0 },
        "activeDeadlineSeconds": { "type": "integer", "minimum": 1 },
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "workSizeLimit": { "type": "string" },
        "nodeSelector": { "$ref": "#/definitions/stringMap" },
        "tolerations": { "type": "array", "items": { "type": "object" } },
        "image": { "$ref": "#/definitions/image" },
        "resources": { "type": "object" },
        "upload": { "$ref": "#/definitions/containerContract" }
      }
    },
    "restoreCheck": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "serviceAccountName": { "type": "string", "minLength": 1 },
        "serviceAccountAnnotations": { "$ref": "#/definitions/stringMap" },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "baoRole": { "type": "string", "minLength": 1 },
        "schedule": { "type": "string", "minLength": 1 },
        "timeZone": { "type": "string", "minLength": 1 },
        "startingDeadlineSeconds": { "type": "integer", "minimum": 0 },
        "activeDeadlineSeconds": { "type": "integer", "minimum": 1 },
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "workSizeLimit": { "type": "string" },
        "nodeId": { "type": "string", "minLength": 1 },
        "nodeSelector": { "$ref": "#/definitions/stringMap" },
        "tolerations": { "type": "array", "items": { "type": "object" } },
        "maxSnapshotAgeSeconds": { "type": "integer", "minimum": 60 },
        "image": { "$ref": "#/definitions/image" },
        "sealConfig": { "type": "string" },
        "sealDescription": { "type": "string" },
        "auditConfig": { "type": "string" },
        "serverEnv": { "type": "array", "items": { "type": "object" } },
        "serverResources": { "type": "object" },
        "resources": { "type": "object" },
        "fetch": { "$ref": "#/definitions/containerContract" },
        "canary": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "kvMount": { "type": "string", "minLength": 1 },
            "path": { "type": "string", "minLength": 1 },
            "namespaces": { "type": "array", "items": { "$ref": "#/definitions/name" } }
          }
        },
        "pki": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "trustAnchor": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string" },
                "certificate": { "type": "string", "description": "base64 PEM" }
              }
            },
            "intermediate": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mount": { "type": "string", "minLength": 1 },
                "issuer": { "type": "string" }
              }
            },
            "issuing": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mount": { "type": "string", "minLength": 1 },
                "issuerPrefix": { "type": "string" }
              }
            },
            "namespaces": { "type": "array", "items": { "$ref": "#/definitions/name" } },
            "role": { "type": "string", "minLength": 1 },
            "domain": { "type": "string" },
            "ttl": { "type": "string", "minLength": 1 },
            "refusals": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "namespace": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "certificateExpiry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "name": { "type": "string", "minLength": 1 },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "certificateName": { "type": "string" },
        "clusterName": { "type": "string" },
        "certManagerNamespace": { "type": "string", "minLength": 1 },
        "schedule": { "type": "string", "minLength": 1 },
        "timeZone": { "type": "string", "minLength": 1 },
        "startingDeadlineSeconds": { "type": "integer", "minimum": 0 },
        "activeDeadlineSeconds": { "type": "integer", "minimum": 1 },
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "alertBeforeSeconds": { "type": "integer", "minimum": 86400 },
        "renewBeforeSeconds": { "type": "integer", "minimum": 0 },
        "nodeSelector": { "$ref": "#/definitions/stringMap" },
        "tolerations": { "type": "array", "items": { "type": "object" } },
        "read": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "image": { "$ref": "#/definitions/image" },
            "resources": { "type": "object" }
          }
        },
        "alert": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "image": { "$ref": "#/definitions/image" },
            "command": { "type": "array", "items": { "type": "string" } },
            "args": { "type": "array", "items": { "type": "string" } },
            "env": { "type": "array", "items": { "type": "object" } },
            "resources": { "type": "object" },
            "sns": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "topicArn": { "type": "string" },
                "region": { "type": "string" },
                "runbook": { "type": "string" }
              }
            },
            "alertmanager": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "url": { "type": "string" },
                "alertname": { "type": "string", "minLength": 1 },
                "severity": { "type": "string", "minLength": 1 },
                "release": { "type": "string" },
                "runbook": { "type": "string" },
                "image": { "$ref": "#/definitions/image" }
              }
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "names": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "serverIngress": { "type": "string", "minLength": 1 },
            "restoreCheckIngress": { "type": "string", "minLength": 1 },
            "certificateExpiryIngress": { "type": "string", "minLength": 1 }
          }
        },
        "clientCidrs": { "type": "array", "items": { "type": "string" } },
        "extraClientSelectors": { "type": "array", "items": { "type": "object" } },
        "isolated": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "podSelector"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "podSelector": { "$ref": "#/definitions/stringMap" }
            }
          }
        },
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "podSelector", "egress"],
                "properties": {
                  "name": { "type": "string", "minLength": 1 },
                  "apiVersion": { "type": "string", "minLength": 1 },
                  "kind": { "type": "string", "minLength": 1 },
                  "podSelector": { "$ref": "#/definitions/stringMap" },
                  "egress": { "type": "array", "items": { "type": "object" } }
                }
              }
            }
          }
        }
      }
    },
    "serverCertificate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "externalDnsName": { "type": "string" },
        "commonName": { "type": "string" },
        "serviceDnsNames": { "type": "boolean" },
        "extraDnsNames": { "type": "array", "items": { "type": "string" } },
        "ipAddresses": { "type": "array", "items": { "type": "string" } },
        "duration": { "type": "string" },
        "renewBefore": { "type": "string" },
        "privateKey": { "type": "object" },
        "issuerRef": { "type": "object" },
        "annotations": { "$ref": "#/definitions/stringMap" }
      }
    },
    "tlsReload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "intervalSeconds": { "type": "integer", "minimum": 1 },
        "certPath": { "type": "string", "minLength": 1 },
        "volumeName": { "type": "string", "minLength": 1 },
        "mountPath": { "type": "string", "minLength": 1 },
        "image": { "$ref": "#/definitions/image" },
        "resources": { "type": "object" }
      }
    }
  },
  "definitions": {
    "stringMap": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["", "Always", "IfNotPresent", "Never"] }
      }
    },
    "containerContract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": { "$ref": "#/definitions/image" },
        "command": { "type": "array", "items": { "type": "string" } },
        "args": { "type": "array", "items": { "type": "string" } },
        "env": { "type": "array", "items": { "type": "object" } },
        "resources": { "type": "object" },
        "s3": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "bucket": { "type": "string" },
            "region": { "type": "string" },
            "prefix": { "type": "string" },
            "checksumAlgorithm": { "type": "string" }
          }
        }
      }
    }
  }
}
