{
  "Statement": [
    {
      "Action": [
        "sts:AssumeRole",
        "sts:TagSession"
      ],
      "Condition": {
        "ArnEquals": {
          "aws:SourceArn": "arn:aws:eks:eu-example-1:111122223333:cluster/a"
        },
        "StringEquals": {
          "aws:RequestTag/kubernetes-namespace": "external-secrets",
          "aws:RequestTag/kubernetes-service-account": "external-secrets",
          "aws:SourceAccount": "111122223333"
        }
      },
      "Effect": "Allow",
      "Principal": {
        "Service": "pods.eks.amazonaws.com"
      },
      "Sid": "ExternalSecretsOperator"
    }
  ],
  "Version": "2012-10-17"
}
