{
  "Statement": [
    {
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:ssm:eu-example-1:444455556666:parameter/app/credentials/*",
        "arn:aws:ssm:eu-example-1:444455556666:parameter/app/token"
      ],
      "Sid": "ReadParameters"
    },
    {
      "Action": [
        "ssm:GetParametersByPath"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:ssm:eu-example-1:444455556666:parameter/app/credentials",
        "arn:aws:ssm:eu-example-1:444455556666:parameter/app/credentials/*"
      ],
      "Sid": "ReadParametersByPath"
    },
    {
      "Action": [
        "kms:Decrypt"
      ],
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "ssm.eu-example-1.amazonaws.com"
        },
        "StringLike": {
          "kms:EncryptionContext:PARAMETER_ARN": [
            "arn:aws:ssm:eu-example-1:444455556666:parameter/app/credentials/*",
            "arn:aws:ssm:eu-example-1:444455556666:parameter/app/token"
          ]
        }
      },
      "Effect": "Allow",
      "Resource": "arn:aws:kms:eu-example-1:444455556666:key/1234abcd-12ab-34cd-56ef-1234567890ab",
      "Sid": "DecryptParameters"
    }
  ],
  "Version": "2012-10-17"
}
